# Studio Clayrity — environment variables
# Copy to `.env.local` for local development. Never commit real values.
# Each Vercel environment (Preview = staging, Production) has its own values.
# Validation lives in src/lib/env.ts — the build fails if a value is malformed.

# ---- App ---------------------------------------------------------------
# local | staging | production  (production enforces required variables)
APP_ENV=local
# Public base URL, used for canonical URLs, sitemaps and emails
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Database & auth (Supabase, region ap-south-1) — Phase 3 -----------
# Postgres connection string. Local: docker compose up -d, then
#   postgres://postgres:postgres@localhost:5433/studioclayrity
# Supabase: use the pooled "Transaction" connection string (port 6543).
DATABASE_URL=
# Disposable database for `pnpm test:integration` (it is wiped on every run; name must contain "test")
TEST_DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Payments (Razorpay) — Phase 6 --------------------------------------
# Test keys (rzp_test_...) everywhere except production
RAZORPAY_KEY_ID=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
# Server-only
RAZORPAY_KEY_SECRET=
# Secret configured on the Razorpay webhook (URL: /api/webhooks/razorpay); used to verify signatures
RAZORPAY_WEBHOOK_SECRET=

# ---- Email (Resend) — Phase 7 -------------------------------------------
RESEND_API_KEY=
# e.g. orders@studioclayrity.com (domain must be verified in Resend)
EMAIL_FROM=
# Where new-order notifications and the daily low-stock summary go
OWNER_NOTIFICATION_EMAIL=

# ---- Images (Cloudinary) ------------------------------------------------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
# Server-only (signed uploads)
CLOUDINARY_API_SECRET=

# ---- Shipping (Shiprocket) — Phase 7 ------------------------------------
# A dedicated Shiprocket "API user" (Settings → API → Create API user), not the owner's login
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
# Pickup location name exactly as in Shiprocket (Settings → Pickup addresses), and its PIN code
SHIPROCKET_PICKUP_LOCATION=
SHIPROCKET_PICKUP_PINCODE=
# Token Shiprocket sends in the x-api-key header of tracking webhooks
# (webhook URL: /api/webhooks/courier-tracking — Shiprocket rejects URLs containing "shiprocket")
SHIPROCKET_WEBHOOK_TOKEN=

# ---- Rate limiting (Upstash Redis) --------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- Spam protection (Cloudflare Turnstile) -----------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---- Monitoring (Sentry) ------------------------------------------------
SENTRY_DSN=

# ---- Internal ------------------------------------------------------------
# /styleguide is hidden when APP_ENV=production unless this is "true" (pre-launch review)
SHOW_STYLEGUIDE=

# ---- Cron ---------------------------------------------------------------
# Bearer token Vercel Cron sends to /api/cron/* routes
CRON_SECRET=
