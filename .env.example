# Studio Clayrity — environment variables
# Copy to `.env.local` for local development. Never commit real values.
# Each Vercel environment (Preview = staging, Production) has its own values.
# Validation lives in src/lib/env.ts — the build fails if a value is malformed.

# ---- App ---------------------------------------------------------------
# local | staging | production  (production enforces required variables)
APP_ENV=local
# Public base URL, used for canonical URLs, sitemaps and emails
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Database & auth (Supabase, region ap-south-1) — Phase 3 -----------
# Postgres connection string (use the pooled connection for serverless)
DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Payments (Razorpay) — Phase 6 --------------------------------------
# Test keys (rzp_test_...) everywhere except production
RAZORPAY_KEY_ID=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
# Server-only
RAZORPAY_KEY_SECRET=
# Secret configured on the Razorpay webhook; used to verify signatures
RAZORPAY_WEBHOOK_SECRET=

# ---- Email (Resend) — Phase 7 -------------------------------------------
RESEND_API_KEY=
# e.g. orders@studioclayrity.com (domain must be verified in Resend)
EMAIL_FROM=
# Where new-order / enquiry notifications go
OWNER_NOTIFICATION_EMAIL=

# ---- Images (Cloudinary) ------------------------------------------------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
# Server-only (signed uploads)
CLOUDINARY_API_SECRET=

# ---- Shipping (Shiprocket) — Phase 7 ------------------------------------
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
# Token expected on incoming tracking webhooks
SHIPROCKET_WEBHOOK_TOKEN=

# ---- Rate limiting (Upstash Redis) --------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- Spam protection (Cloudflare Turnstile) -----------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---- Monitoring (Sentry) ------------------------------------------------
SENTRY_DSN=

# ---- Internal ------------------------------------------------------------
# /styleguide is hidden when APP_ENV=production unless this is "true" (pre-launch review)
SHOW_STYLEGUIDE=

# ---- Cron ---------------------------------------------------------------
# Bearer token Vercel Cron sends to /api/cron/* routes
CRON_SECRET=
